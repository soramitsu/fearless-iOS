#include "../../Pods/Target Support Files/Pods-fearlessAll-fearless/Pods-fearlessAll-fearless.debug.xcconfig"

OTHER_SWIFT_FLAGS = $(inherited) "-DENABLE_UITUNNEL" "-DF_DEV"

APP_NAME = Fearless Dev
ICON_SUFFIX = Dev

FEARLESS_GOOGLE_TOKEN = 
FEARLESS_GOOGLE_URL_SCHEME = 

// Set NO to restore the legacy Welcome presentation without changing routing.
FW_RESTYLE_WELCOME = YES
FW_RESTYLE_WALLET_ENTRY = YES
FW_RESTYLE_ACCOUNT_CREATE = YES
FW_RESTYLE_ACCOUNT_CONFIRM = YES
FW_RESTYLE_ACCOUNT_EXPORT_PASSWORD = YES
FW_RESTYLE_EXPORT_GENERIC = YES
FW_RESTYLE_STARTUP_RECOVERY = YES
FW_RESTYLE_WALLET_HEADER = YES
FW_RESTYLE_PORTFOLIO_LIST = YES
FW_RESTYLE_SEND_PRESENTATION = YES
FW_RESTYLE_RECEIVE_PRESENTATION = YES
FW_RESTYLE_ASSET_MANAGEMENT = YES

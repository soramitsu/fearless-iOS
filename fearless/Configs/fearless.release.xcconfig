#include "../../Pods/Target Support Files/Pods-fearlessAll-fearless/Pods-fearlessAll-fearless.release.xcconfig"

OTHER_SWIFT_FLAGS = $(inherited) "-DF_RELEASE"

APP_NAME = Fearless

FEARLESS_GOOGLE_TOKEN = 
FEARLESS_GOOGLE_URL_SCHEME = 

// Harden Release builds for performance and safety
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
ENABLE_TESTABILITY = NO
ONLY_ACTIVE_ARCH = NO
DEAD_CODE_STRIPPING = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_DEBUG_SYMBOLS_DURING_COPY = YES
// Prefer size optimizations for extensions if needed by overriding at target level
// SWIFT_OPTIMIZATION_LEVEL[sdk=iphoneos*] = -O
// SWIFT_OPTIMIZATION_LEVEL[sdk=iphonesimulator*] = -O

// Set NO to restore the legacy Welcome presentation without changing routing.
FW_RESTYLE_WELCOME = YES
FW_RESTYLE_WALLET_ENTRY = YES
FW_RESTYLE_ACCOUNT_CREATE = YES
FW_RESTYLE_ACCOUNT_CONFIRM = YES
FW_RESTYLE_ACCOUNT_EXPORT_PASSWORD = YES
FW_RESTYLE_EXPORT_GENERIC = YES
FW_RESTYLE_STARTUP_RECOVERY = YES
FW_RESTYLE_WALLET_HEADER = YES
FW_RESTYLE_PORTFOLIO_LIST = YES
FW_RESTYLE_SEND_PRESENTATION = YES
FW_RESTYLE_RECEIVE_PRESENTATION = YES
FW_RESTYLE_ASSET_MANAGEMENT = YES

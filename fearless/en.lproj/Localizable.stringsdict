    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@format@</string>
      <key>format</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>li</string>
        <key>one</key>
        <string>+ %li other</string>
        <key>other</key>
        <string>+ %li others</string>
      </dict>
    </dict>
    <key>staking.analytics.validators.eras.counter</key>

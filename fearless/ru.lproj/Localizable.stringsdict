        <key>NSStringFormatValueTypeKey</key>
        <string>li</string>
        <key>one</key>
        <string>%li час</string>
        <key>few</key>
        <string>%li часа</string>
        <key>many</key>
        <string>%li часов</string>
        <key>other</key>
        <string>%li час</string>
      </dict>
    </dict>

    <key>wallet.records.notice.wallets</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@format@</string>
      <key>format</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>li</string>
        <key>one</key>
        <string>Не удаётся отобразить %li сохранённый кошелёк</string>
        <key>few</key>
        <string>Не удаётся отобразить %li сохранённых кошелька</string>
        <key>many</key>
        <string>Не удаётся отобразить %li сохранённых кошельков</string>
        <key>other</key>
        <string>Не удаётся отобразить %li сохранённых кошельков</string>
      </dict>
    </dict>
    <key>wallet.records.notice.accounts</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@format@</string>
      <key>format</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>li</string>
        <key>one</key>
        <string>Не удаётся использовать %li сетевой аккаунт</string>
        <key>few</key>
        <string>Не удаётся использовать %li сетевых аккаунта</string>
        <key>many</key>
        <string>Не удаётся использовать %li сетевых аккаунтов</string>
        <key>other</key>
        <string>Не удаётся использовать %li сетевых аккаунтов</string>

# Preferred unattended authentication. Keep the .p8 file outside this repository.
APP_STORE_CONNECT_API_KEY_KEY_ID=
# Leave issuer ID blank only for an individual App Store Connect API key.
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
# Example: /absolute/path/outside/repository/AuthKey_KEYID.p8
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=

# The tester address is read from the environment and stored only as SHA-256 in receipts.
TESTFLIGHT_TESTER_EMAIL=
# Optional. When omitted, exactly one internal group containing the tester must exist.
TESTFLIGHT_INTERNAL_GROUP_ID=

TESTFLIGHT_VERSION=4.2.0
TESTFLIGHT_BUILD=2026.8.33
TESTFLIGHT_PROCESSING_TIMEOUT=3600
TESTFLIGHT_PROCESSING_POLL_INTERVAL=30

# Apple-ID fallback requires both variables. Generate FASTLANE_SESSION with
# `fastlane spaceauth -u you@example.com`; an app-specific password cannot manage groups.
# FASTLANE_USER=
# FASTLANE_SESSION=
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=
# Required when the Apple account belongs to multiple App Store Connect teams.
# FASTLANE_ITC_TEAM_ID=
